    {
      "parameters": {
        "jsCode": "\nconst items = $items(\"Baca Data\");\n\nlet positive = 0;\nlet negative = 0;\nlet neutral = 0;\n\nfor (const item of items) {\n  const sentiment = String(item.json.Sentimen || \"\")\n    .trim()\n    .toLowerCase();\n\n  if (sentiment === \"positive\") {\n    positive++;\n  } else if (sentiment === \"negative\") {\n    negative++;\n  } else if (sentiment === \"neutral\") {\n    neutral++;\n  }\n}\n\nconst total = positive + negative + neutral;\n\nconst percentage = (count) =>\n  total > 0\n    ? Number(((count / total) * 100).toFixed(2))\n    : 0;\n\nreturn [\n  {\n    json: {\n      total_tweets: total,\n      sentimen_positif: positive,\n      persentase_positif: percentage(positive),\n      sentimen_negatif: negative,\n      persentase_negatif: percentage(negative),\n      sentimen_netral: neutral,\n      persentase_netral: percentage(neutral),\n    },\n  },\n];"
      },
      "name": "Analisis Data",
      "type": "n8n-nodes-base.code",
      "position": [
