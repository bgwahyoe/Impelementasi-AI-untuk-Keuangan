    {
      "parameters": {
        "html": "\n<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Invoice Jasa</title>\n  <style>\n    body {\n      font-family: Arial, sans-serif;\n      color: #263238;\n      padding: 30px;\n      background: #f4f7fb;\n    }\n    .invoice {\n      max-width: 700px;\n      margin: auto;\n      padding: 35px;\n      background: white;\n      border: 1px solid #ddd;\n    }\n    .header {\n      border-bottom: 3px solid #2563eb;\n      padding-bottom: 15px;\n      margin-bottom: 25px;\n    }\n    h1 { color: #2563eb; margin-bottom: 5px; }\n    .label { color: #64748b; font-size: 13px; }\n    table {\n      width: 100%;\n      border-collapse: collapse;\n      margin-top: 20px;\n    }\n    th, td {\n      padding: 12px;\n      border-bottom: 1px solid #e2e8f0;\n      text-align: left;\n    }\n    th { background: #eff6ff; }\n    .total {\n      text-align: right;\n      font-size: 22px;\n      font-weight: bold;\n      color: #2563eb;\n      margin-top: 25px;\n    }\n    .footer {\n      margin-top: 45px;\n      color: #64748b;\n      font-size: 12px;\n      text-align: center;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"invoice\">\n    <div class=\"header\">\n      <h1>INVOICE</h1>\n      <div class=\"label\">Tagihan Jasa Pekerjaan</div>\n      <p>Nomor Invoice: INV-{{ $execution.id }}</p>\n      <p>Tanggal: {{ $now.setZone('Asia/Jakarta').toFormat('dd-MM-yyyy') }}</p>\n    </div>\n\n    <h3>Ditagihkan Kepada</h3>\n    <p><strong>{{ $('On form submission').item.json['Nama Klien'] }}</strong></p>\n    <p>{{ $('On form submission').item.json['Email Klien'] }}</p>\n\n    <h3>Detail Tagihan</h3>\n    <table>\n      <thead>\n        <tr>\n          <th>Deskripsi</th>\n          <th>Jam Kerja</th>\n          <th>Rate per Jam</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Jasa Pekerjaan / Konsultasi</td>\n          <td>{{ $('On form submission').item.json['Jam Kerja'] }} jam</td>\n          <td>Rp{{ $('On form submission').item.json['Rate per jam'] }}</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <div class=\"total\">\n      Total Biaya: {{ $json[\"Total Biaya\"] }}\n    </div>\n\n    <div class=\"footer\">\n      Invoice ini dibuat secara otomatis.<br>\n      Terima kasih atas kepercayaan Anda.\n    </div>\n  </div>\n</body>\n</html>"
      },
