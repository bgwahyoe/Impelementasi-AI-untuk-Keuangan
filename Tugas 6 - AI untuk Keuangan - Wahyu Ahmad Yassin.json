    },
    {
      "parameters": {
        "jsCode": "\nconst llmOutput = $json.text;\n\n// Ambil Message ID dari Gmail Trigger\nconst emailMessageId = $('Gmail Trigger').first().json.id;\n\n// Ekstrak skor dari respons AI\nconst match = llmOutput.match(/Skor:\\s*(\\d+)/);\n\nlet score = 0;\n\nif (match && match[1]) {\n  score = parseInt(match[1], 10);\n}\n\n// Tentukan kategori berdasarkan skor\nlet riskCategory;\n\nif (score < 1 || score > 10) {\n  riskCategory = 'Tidak Valid';\n} else if (score > 6) {\n  riskCategory = 'Phishing';\n} else {\n  riskCategory = 'Perlu Tinjauan';\n}\n\n// Kembalikan hasil\nreturn {\n  score: score,\n  riskCategory: riskCategory,\n  messageId: emailMessageId\n};"
      },
